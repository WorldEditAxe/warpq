#!/bin/sh /etc/rc.common
USE_PROCD=1
START=90
STOP=10

PROG=/usr/sbin/warpq
CONFIG=/etc/warpq.json

start_service() {
	local enabled iface mtu port routed ipv6 workers

	config_load warpq
	config_get_bool enabled config enabled 0
	config_get iface config interface warp0
	config_get mtu config mtu 1280
	config_get port config port 443
	config_get_bool routed config default_route 1
	config_get_bool ipv6 config ipv6_endpoint 0
	config_get workers config workers 2

	[ "$enabled" = 1 ] || return 0

	[ -f "$CONFIG" ] || {
		logger -t warpq "registering a new WARP device"
		"$PROG" register -c "$CONFIG" -n "$(cat /proc/sys/kernel/hostname)" || {
			logger -t warpq "registration failed"
			return 1
		}
	}

	procd_open_instance
	procd_set_param command "$PROG" up -c "$CONFIG" -i "$iface" -m "$mtu" -p "$port" -t "$workers"
	[ "$routed" = 1 ] || procd_append_param command --no-route
	[ "$ipv6" = 1 ] && procd_append_param command -6
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger warpq
}

# procd's default restart stops and starts back to back. The daemon removes its
# routing rules as it exits, so that teardown can land *after* the new instance
# has installed its own -- leaving table 30561 empty and every packet falling
# through to the WAN. Wait for the old process to be gone before starting again.
restart() {
	stop "$@"

	local i=0
	while pgrep -f "$PROG up" >/dev/null 2>&1 && [ "$i" -lt 30 ]; do
		sleep 1
		i=$((i + 1))
	done
	sleep 1

	start "$@"
}
